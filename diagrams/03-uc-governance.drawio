          <mxGeometry x="520" y="505" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="schema-quarantine" value="&lt;b&gt;quarantine&lt;/b&gt;&lt;br&gt;Bad-record DLQ&lt;br&gt;Schema-violations&lt;br&gt;Manual review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=2;fontSize=10;align=center;spacing=4;" vertex="1" parent="1">
