        </mxCell>
        <mxCell id="agency-label" value="&lt;b&gt;AGENCY-OWNED AWS ACCOUNTS&lt;/b&gt;&lt;br&gt;(20+ accounts, separate AWS Orgs)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#E65100;" vertex="1" parent="1">
