        <mxCell id="fail-1" value="&lt;b&gt;1. run_as identity&lt;/b&gt;&lt;br&gt;Different SP per target?&lt;br&gt;Has prod SP been granted USE on the catalog?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=2;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
