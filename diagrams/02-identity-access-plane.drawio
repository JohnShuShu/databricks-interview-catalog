        <mxCell id="acct-roles" value="&lt;b&gt;ACCOUNT ROLES&lt;/b&gt;&lt;br&gt;&lt;br&gt;Account Admin&lt;br&gt;Metastore Admin&lt;br&gt;Workspace Admin&lt;br&gt;Marketplace Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#42A5F5;strokeColor=#1565C0;strokeWidth=2;fontSize=10;align=center;fontColor=#FFFFFF;" vertex="1" parent="1">
