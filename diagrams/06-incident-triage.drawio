        <mxCell id="art-5" value="&lt;b&gt;5. Cluster events&lt;/b&gt;&lt;br&gt;clusters/events API for affected job clusters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="685" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art-6" value="&lt;b&gt;6. AWS-side metrics&lt;/b&gt;&lt;br&gt;CloudWatch: S3 5xx, NAT bytes, VPCE PacketsDrop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="745" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art-7" value="&lt;b&gt;7. Bundle / Terraform state&lt;/b&gt;&lt;br&gt;Has anything been deployed in last 4 hours? git log --since." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
