        </mxCell>
        <mxCell id="subtitle" value="One CISA workspace account · 20+ agency-owned AWS accounts · PrivateLink + scoped storage credentials" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#616161;fontStyle=2" vertex="1" parent="1">
