        </mxCell>
        <mxCell id="schema-volumes" value="&lt;b&gt;_volumes&lt;/b&gt;&lt;br&gt;PCAP, binaries&lt;br&gt;Forensic artifacts&lt;br&gt;UC Volumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B39DDB;strokeColor=#4527A0;strokeWidth=2;fontSize=10;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1160" y="505" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- LEVEL: Policies -->
        <mxCell id="pol-section" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1320" height="225" as="geometry" />
        </mxCell>
        <mxCell id="pol-label" value="&lt;b&gt;FINE-GRAINED ACCESS POLICIES&lt;/b&gt;  •  Applied at table or column level" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#AD1457;" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- Row filter -->
        <mxCell id="pol-row-title" value="&lt;b&gt;ROW FILTER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#AD1457;strokeWidth=2;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="685" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pol-row-code" value="CREATE FUNCTION agency_filter(a STRING)&lt;br&gt;RETURNS BOOLEAN RETURN&lt;br&gt;&amp;nbsp;&amp;nbsp;is_account_group_member(&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;'agency-' || a || '-readers');&lt;br&gt;&lt;br&gt;ALTER TABLE bronze.network_logs&lt;br&gt;SET ROW FILTER agency_filter ON (agency);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;strokeWidth=1;fontSize=9;align=left;fontFamily=Courier New;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="720" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Column mask -->
        <mxCell id="pol-col-title" value="&lt;b&gt;COLUMN MASK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#AD1457;strokeWidth=2;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="685" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pol-col-code" value="CREATE FUNCTION mask_pii(v STRING)&lt;br&gt;RETURNS STRING RETURN&lt;br&gt;&amp;nbsp;&amp;nbsp;CASE WHEN is_account_group_member('soc-l3')&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;THEN v&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ELSE '***REDACTED***' END;&lt;br&gt;&lt;br&gt;ALTER TABLE silver.endpoint_events ALTER&lt;br&gt;COLUMN user_email SET MASK mask_pii;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;strokeWidth=1;fontSize=9;align=left;fontFamily=Courier New;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="720" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Tag-based ABAC -->
        <mxCell id="pol-tag-title" value="&lt;b&gt;TAG-BASED ABAC&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#AD1457;strokeWidth=2;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="720" y="685" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pol-tag-code" value="-- Tag once, govern broadly&lt;br&gt;ALTER COLUMN ssn SET TAGS&lt;br&gt;&amp;nbsp;&amp;nbsp;('pii'='true', 'classification'='cui');&lt;br&gt;&lt;br&gt;-- One mask handles all tagged columns&lt;br&gt;-- across 80+ schemas&lt;br&gt;-- → declarative, auditable, scalable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AD1457;strokeWidth=1;fontSize=9;align=left;fontFamily=Courier New;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="720" y="720" width="300" height="130" as="geometry" />
        </mxCell>

        <!-- Drift detection -->
        <mxCell id="pol-drift-title" value="&lt;b&gt;DRIFT DETECTION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD54F;strokeColor=#F57F17;strokeWidth=2;fontSize=11;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1040" y="685" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="pol-drift-code" value="SELECT * FROM&lt;br&gt;&amp;nbsp;&amp;nbsp;system.information_schema.privileges&lt;br&gt;WHERE grantee NOT IN (SELECT name&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;FROM tf_state.expected_grants);&lt;br&gt;&lt;br&gt;-- Cron'd via Lakeflow → alert SOC&lt;br&gt;-- Reconcile against Terraform state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=9;align=left;fontFamily=Courier New;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="720" width="300" height="130" as="geometry" />
        </mxCell>

