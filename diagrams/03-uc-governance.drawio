        <mxCell id="schema-bronze" value="&lt;b&gt;bronze&lt;/b&gt;&lt;br&gt;Raw / append-only&lt;br&gt;Source-system fidelity&lt;br&gt;_rescued_data captured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=10;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="505" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="schema-silver" value="&lt;b&gt;silver&lt;/b&gt;&lt;br&gt;Validated, deduped&lt;br&gt;Liquid clustering&lt;br&gt;Joined enrichments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#455A64;strokeWidth=2;fontSize=10;align=center;spacing=4;" vertex="1" parent="1">
