        <mxCell id="sp-ingest" value="&lt;b&gt;sp-ingest-*&lt;/b&gt;&lt;br&gt;Reads agency S3 → writes Bronze&lt;br&gt;Cluster policy: ingest-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
