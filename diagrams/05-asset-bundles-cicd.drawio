        </mxCell>
        <mxCell id="fail-3" value="&lt;b&gt;3. Workspace permissions&lt;/b&gt;&lt;br&gt;Is the deploy SP a workspace user?&lt;br&gt;Has it CAN_MANAGE on existing resources?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;strokeWidth=2;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
