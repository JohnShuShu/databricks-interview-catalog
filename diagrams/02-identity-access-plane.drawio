        <mxCell id="acct-oauth" value="&lt;b&gt;OAUTH M2M&lt;/b&gt;&lt;br&gt;&lt;br&gt;Federated tokens (OIDC)&lt;br&gt;GitHub Actions trust&lt;br&gt;Short-lived secrets&lt;br&gt;Auto-rotated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E88E5;strokeColor=#0D47A1;strokeWidth=2;fontSize=10;align=center;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="1020" y="335" width="280" height="120" as="geometry" />
