        <mxCell id="schema-label" value="&lt;b&gt;LEVEL 2: SCHEMAS (80+)&lt;/b&gt;  •  Boundary = data layer / source / sensor" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1">
