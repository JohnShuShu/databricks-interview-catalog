          <mxGeometry x="40" y="510" width="1320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="enf-label" value="&lt;b&gt;ENFORCEMENT LAYERS&lt;/b&gt;  •  Defense-in-depth: each layer can deny independently" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- Workspace ACLs -->
        <mxCell id="enf-ws" value="&lt;b&gt;WORKSPACE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="555" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enf-ws-detail" value="• IP access lists&lt;br&gt;• Token policies (TTL, scope)&lt;br&gt;• Workspace user assignment&lt;br&gt;• Login frequency&lt;br&gt;• Egress firewall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- UC Grants -->
        <mxCell id="enf-uc" value="&lt;b&gt;UNITY CATALOG&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="350" y="555" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enf-uc-detail" value="• GRANT/REVOKE catalog→table&lt;br&gt;• Row filters (function-based)&lt;br&gt;• Column masks&lt;br&gt;• Tag-based ABAC&lt;br&gt;• External location ACLs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="590" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Cluster policies -->
        <mxCell id="enf-compute" value="&lt;b&gt;COMPUTE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="555" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enf-compute-detail" value="• Cluster policies (whitelisted)&lt;br&gt;• Init scripts allow-list&lt;br&gt;• Instance profile pinning&lt;br&gt;• Single-user vs shared isolation&lt;br&gt;• Photon-only enforcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="590" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Secrets & Apps -->
        <mxCell id="enf-secrets" value="&lt;b&gt;SECRETS / APPS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="890" y="555" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enf-secrets-detail" value="• Databricks-backed scopes&lt;br&gt;• AWS SM / Azure KV&lt;br&gt;• ACLs per scope&lt;br&gt;• App on-behalf-of user&lt;br&gt;• OAuth user-to-machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="890" y="590" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Audit / detective -->
        <mxCell id="enf-audit" value="&lt;b&gt;AUDIT / DETECTIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFD54F;strokeColor=#F57F17;strokeWidth=2;fontSize=12;align=center;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1120" y="555" width="220" height="30" as="geometry" />
        </mxCell>
        <mxCell id="enf-audit-detail" value="• system.access.audit&lt;br&gt;• information_schema.privileges&lt;br&gt;• Query history&lt;br&gt;• Cluster events&lt;br&gt;• Drift detector → SOC alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="590" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- LAYER 4: Service Principal usage callout -->
