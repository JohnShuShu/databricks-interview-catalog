        <mxCell id="art-1" value="&lt;b&gt;1. Pipeline event log&lt;/b&gt;&lt;br&gt;event_log() table — last 4 hours" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="435" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art-2" value="&lt;b&gt;2. Spark driver thread dump&lt;/b&gt;&lt;br&gt;UI · Executor 0 · Thread Dump → snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="495" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art-3" value="&lt;b&gt;3. system.access.audit slice&lt;/b&gt;&lt;br&gt;COPY INTO last 4hr to incident catalog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="555" width="410" height="50" as="geometry" />
        </mxCell>
        <mxCell id="art-4" value="&lt;b&gt;4. Query history snapshot&lt;/b&gt;&lt;br&gt;system.query.history WHERE state IN ('FAILED','CANCELLED')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F57F17;strokeWidth=1;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
