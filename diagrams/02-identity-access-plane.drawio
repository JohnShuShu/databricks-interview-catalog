        </mxCell>
        <mxCell id="sp-label" value="&lt;b&gt;SERVICE PRINCIPAL USAGE PATTERNS&lt;/b&gt;  •  Humans never read raw catalogs — only SPs running governed jobs do" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#6A1B9A;" vertex="1" parent="1">
          <mxGeometry x="60" y="765" width="900" height="25" as="geometry" />
