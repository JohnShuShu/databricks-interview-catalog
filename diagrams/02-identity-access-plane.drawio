        <mxCell id="sp-app" value="&lt;b&gt;sp-app-*&lt;/b&gt;&lt;br&gt;Apps backend identity&lt;br&gt;Propagates end-user via OBO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#6A1B9A;strokeWidth=2;fontSize=10;align=left;spacing=8;" vertex="1" parent="1">
